{
  "name": "subnet-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Visual-first IPv4 network planning tool: overlap detection, VLSM allocation, multi-vendor config output.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "esbuild src/shell/main.ts --bundle --minify --format=iife --outfile=dist/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
